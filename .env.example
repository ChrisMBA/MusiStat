# Copie ce fichier en .env et remplis les valeurs

# Spotify — https://developer.spotify.com/dashboard
# Redirect URI à déclarer dans l'app Spotify :
#   http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth
# Générer un secret : openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/musistat
